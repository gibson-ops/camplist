# Copy to mobile/.env and fill in. All EXPO_PUBLIC_* values ship in the client bundle —
# that's fine here: the Instant app id and Clerk publishable key are both public by design,
# and access is enforced by the CEL rules in instant.perms.ts.

# InstantDB app id. Dev app: camplist-dev
EXPO_PUBLIC_INSTANT_APP_ID=

# Clerk publishable key for the Camp List Clerk instance (starts with pk_test_ / pk_live_).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Must match the name used in: instant-cli auth client add --type clerk --name <name>
EXPO_PUBLIC_INSTANT_CLERK_CLIENT_NAME=clerk
