# Copy to mobile/.env and fill in.
#
# There is only one value, and it's public by design: the Instant app id ships in the client
# bundle, and access is enforced by the CEL rules in instant.perms.ts. No auth provider keys
# are needed, because the app signs in as an InstantDB guest on first launch.

# InstantDB app id. Dev app: camplist-dev
EXPO_PUBLIC_INSTANT_APP_ID=
