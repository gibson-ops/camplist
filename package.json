{
  "name": "camplist",
  "version": "0.1.0",
  "private": true,
  "description": "Camp List \u2014 trip-scoped packing lists that get smarter every trip",
  "workspaces": [
    "mobile"
  ],
  "scripts": {
    "instant:push": "instant-cli push",
    "instant:pull": "instant-cli pull",
    "mobile": "npm run start -w mobile",
    "typecheck": "tsc --noEmit && npm run typecheck -w mobile",
    "test": "npm run test -w mobile",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@instantdb/core": "^1.0.52"
  },
  "devDependencies": {
    "@instantdb/admin": "^1.0.52",
    "@types/node": "^26.1.1",
    "instant-cli": "^1.0.52",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
